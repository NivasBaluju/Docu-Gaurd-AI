# Copy this file to .env and adjust values before running in production.

PORT=5000

# Secret used to sign JWTs. Change this to a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret

# 32-byte (64 hex char) key used for AES-256-GCM encryption at rest.
# Leave blank to auto-generate and persist one on first run (data/db/master.key).
AES_MASTER_KEY=

# Optional: real email delivery for OTP codes via SMTP (e.g. Gmail app password).
# If left blank, Docu-Gaurd AI runs in DEV MODE: OTP codes are returned in the API
# response and printed to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Docu-Gaurd AI <no-reply@docu-gaurd.ai>"

# Optional: enable real LLM-powered AI (Claude) instead of the built-in
# heuristic AI engine. If blank, Docu-Gaurd AI uses its fast, offline, rule-based
# AI engine (clause extraction, RAG search, compliance checks, etc.) which
# works fully out of the box with no API key required.
# Force MFA requirement across the application (true/false)
REQUIRE_MFA=true

