' prior written notice in the event of an uncured material breach.\n\nSection 3. Payment Terms\nInvoices shall be payable strictly within thirty (30) days of receipt. Invoices unpaid after 30 days shall accrue late interest of 1.5% per month.\n\nSection 4. Confidentiality Obligations\nRecipient agrees to hold all proprietary trade secrets in strict confidence and shall be liable for injunctive relief in the event of unauthorized disclosure.\n\nSection 5. Limitation of Liability\nNeither party shall be liable for consequential damages, and total aggregate liability shall not exceed fees paid in the preceding twelve (12) months.\n","ocr_confidence":1,"version_group":"c770b395-3e53-4a27-ab26-d3cc1e47f36f","version_number":1,"risk_score":30,"created_at":"2026-09-01T22:16:20.155Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-02T03:46:27.995Z","analysis_status":"COMPLETED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"b281963b-28d0-4543-b55a-54d941b2558c","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"contract_b.pdf","original_name":"contract_b.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"Vendor Services Agreement Section 1...","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":null,"created_at":"2026-09-02T00:22:25.102Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-02T05:52:25.102Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"c456aa77-2e6b-459e-9a5a-aa15e3e04c07","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"c456aa77-2e6b-459e-9a5a-aa15e3e04c07.enc","original_name":"Contract_B_Intelligence_Lease.txt","mime_type":"text/plain","size":249,"sha256":"8f40fd8317137f34509ad88ccb3a8660ace99ef11d493031c73c6a43a7cdb0