ernal":null,"tenant_id":null},{"id":"00756534-3f41-4acd-b569-0143810a2981","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"msa_acme.pdf","original_name":"MSA_Acme_Cloud_2026.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"\nMASTER SERVICES AGREEMENT\nThis Master Services Agreement is entered into as of January 15, 2026.\n\n1. SCOPE OF SERVICES\nVendor shall perform digital infrastructure and cloud engineering services.\n\n2. PAYMENT TERMS\nInvoices shall be payable within 15 days of receipt. Late payments shall accrue interest at 1.5% per month.\n\n3. NOTICE REQUIREMENTS\nAny formal notice required under this agreement shall be in writing and delivered with at least 30 days prior written notice.\n\n4. CURE PERIOD AND DEFAULT\nIn the event of material breach, the defaulting party shall have a cure period of 10 days to remedy the non-compliance.\n\n5. TERMINATION FOR BREACH\nIf a material breach is not cured within the 10 days notice window, the non-breaching party may terminate immediately.\n\n6. LIMITATION OF LIABILITY\nThe aggregate cumulative liability of either party shall not exceed $500,000 USD under any circumstances.\n\n7. INDEMNIFICATION\nVendor shall defend, indemnify, and hold harmless Customer against all third-party claims, liabilities, and damages.\n\n8. GOVERNING LAW\nThis agreement shall be governed by and construed under the laws of the State of Delaware.\n","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":68,"created_at":"2026-09-04T13:07:28.976Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-04T18:37:28.976Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"a294b7ee-19f5-46bb-829c-c9710a665c6c","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"a294b7ee-19f5-46bb-829c-c9710a665c6c.enc","original_name":"Enterprise Subscription Agreement","mime_type":"text/plain","size":0,"sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","encrypted":true,"extracted_text":"","ocr_confidence":1,"version_group":"a294b7ee-19f5-46bb-829c-c9710a665c6c","version_number":1,"risk_score":10,"created_at":"2026-09-04T23:45:59.965Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-05T05:15:59.965Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"2423e24a-0c96-4ba7-a2a0-aa1a50de3bba","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"2423e24a-0c96-4ba7-a2a0-aa1a50de3bba.enc","original_name":"MSA_Acquirer_Provider.txt","mime_type":"text/plain","size":1183,"sha256":"fd62482d3be3a8ad524b96c5b66ca2aa4a7ee0dbce4dd8ef4d187d71dbcdaef7","encrypted":true,"extracted_text":"\nMASTER SERVICES AGREEMENT\nThis Master Services Agreement (\"Agreement\") is made between Acquirer Corp (\"Client\") and Provider Inc (\"Vendor\").\n\n1. TERM AND TERMINATION\nEither party may terminate this Agreement without cause upon sixty (60) days prior written notice.\nIn the event of a material breach, the non-breaching party may terminate immediately if uncured within 15 days.\n\n2. INDEMNIFICATION AND LIABILITY\nVendor shall indemnify, defend, and hold harmless Client against all third-party intellectual property claims.\nNEITHER PARTY SHALL BE LIABLE FOR ANY CONSEQUENTIAL, INDIRECT, OR PUNITIVE DAMAGES.\nTHE TOTAL AGGREGATE LIABILITY OF EITHER PARTY SHALL NOT EXCEED THE TOTAL FEES PAID HEREUNDER IN THE TWELVE (12) MONTHS PRECEDING THE CLAIM.\n\n3. GOVERNING LAW AND JURISDICTION\nThis Agreement shall be governed by and construed in accordance with the laws of the State of Delaware, without regard to conflicts of law principles.\n\n4. CONFIDENTIALITY AND DATA PROTECTION\nEach party agrees to maintain in strict confidence all proprietary information disclosed by the other party.\nSecurity breaches involving Client Data must be reported within twenty-four (24) hours of detection.\n","ocr_confidence":1,"version_group":"2423e24a-0c96-4ba7-a2a0-aa1a50de3bba","version_number":1,"risk_score":33,"created_at":"2026-09-04T13:09:00.428Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-04T18:39:08.277Z","analysis_status":"COMPLETED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"325859a1-0094-4929-885d-d3d1fc9495b1","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"325859a1-0094-4929-885d-d3d1fc9495b1.enc","original_name":"MSA_Acquirer_Provider.txt","mime_type":"text/plain","size":1183,"sha256":"fd62482d3be3a8ad524b96c5b66ca2aa4a7ee0dbce4dd8ef4d187d71dbcdaef7","encrypted":true,"extracted_text":"MASTER SERVICES AGREEMENT\nThis Master Services Agreement (\"Agreement\") is made between Acquirer Corp (\"Client\") and Provider Inc (\"Vendor\").\n\n1. TERM AND TERMINATION\nEither party may terminate this Agreement without cause upon sixty (60) days prior written notice.\nIn the event of a material breach, the non-breaching party may terminate immediately if uncured within 15 days.\n\n2. INDEMNIFICATION AND LIABILITY\nVendor shall indemnify, defend, and hold harmless Client against all third-party intellectual property claims.\nNEITHER PARTY SHALL BE LIABLE FOR ANY CONSEQUENTIAL, INDIRECT, OR PUNITIVE DAMAGES.\nTHE TOTAL AGGREGATE LIABILITY OF EITHER PARTY SHALL NOT EXCEED THE TOTAL FEES PAID HEREUNDER IN THE TWELVE (12) MONTHS PRECEDING THE CLAIM.\n\n3. GOVERNING LAW AND JURISDICTION\nThis Agreement shall be governed by and construed in accordance with the laws of the State of Delaware, without regard to conflicts of law principles.\n\n4. CONFIDENTIALITY AND DATA PROTECTION\nEach party agrees to maintain in strict confidence all proprietary information disclosed by the other party.\nSecurity breaches involving C