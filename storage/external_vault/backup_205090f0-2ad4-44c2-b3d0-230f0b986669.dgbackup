"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"4d49861e-d814-4ad4-90e1-c51c50c483fe","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"MSA_Acme_v2.pdf","original_name":"MSA_Acme_v2.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"\nMASTER SERVICES AGREEMENT (V2)\nEffective Date: October 01, 2025\nThis Agreement expires on October 01, 2026.\nTerm and Renewal: This Agreement shall automatically renew for successive terms of 1 year unless either party gives written notice of at least 30 days prior to expiration.\nLimitation of Liability: The aggregate liability under this agreement shall be limited to $2,000,000 USD.\nPayment Terms: All invoices shall be payable Net 60.\nGoverning Law: This agreement shall be governed by the laws of the State of New York.\nDefault: Party shall cure breach within 30 days of written notice.\n","ocr_confidence":null,"version_group":"6fd8cd39-a4ba-417d-bf3c-e5161fa1daa6","version_number":2,"risk_score":65,"created_at":"2026-09-04T23:56:13.603Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-05T05:26:13.603Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"84528373-4479-492e-9389-0029831a6768","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"Secret_TenantB_Agreement.pdf","original_name":"Secret_TenantB_Agreement.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"\nVENDOR SERVICES AGREEMENT\nEffective Date: October 01, 2025\nThis Agreement expires on October 01, 2026.\nTerm and Renewal: This Agreement automatically renews for 1 year unless written notice of at least 30 days is given prior to expiration.\nLimitation of Liability: The aggregate liability shall not exceed $250,000 USD.\nGoverning Law: This agreement shall be governed by the laws of the State of California.\n","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":50,"created_at":"2026-09-04T23:56:57.950Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-05T05:26:57.950Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"786a4388-af33-465a-86f4-658f7fef5eee","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"Undated_Memo.pdf","original_name":"Undated_Memo.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"General Partnership Memorandum. The partners agree to collaborate on research initiatives.","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":20,"created_at":"2026-09-04T23:57:08.781Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-05T05:27:08.781Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"94a78f1a-f797-427f-8069-cc5ff0cf0c34","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"msa_acme.pdf","original_name":"MSA_Acme_Cloud_2026.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"\nMASTER SERVICES AGREEMENT\nThis Master Services Agreement is entered into as of January 15, 2026.\n\n1. SCOPE OF SERVICES\nVendor shall perform digital infrastructure and cloud engineering services.\n\n2. PAYMENT TERMS\nInvoices shall be payable within 15 days of receipt. Late payments shall accrue interest at 1.5% per month.\n\n3. NOTICE REQUIREMENTS\nAny formal notice required under this agreement shall be in writing and delivered with at least 30 days prior written notice.\n\n4. CURE PERIOD AND DEFAULT\nIn the event of material breach, the defaulting party shall have a cure period of 10 days to remedy the non-compliance.\n\n5. TERMINATION FOR BREACH\nIf a material breach is not cured within the 10 days notice window, the non-breaching party may terminate immediately.\n\n6. LIMITATION OF LIABILITY\nThe aggregate cumulative liability of either party shall not exceed $500,000 USD under any circumstances.\n\n7. INDEMNIFICATION\nVendor shall defend, indemnify, and hold harmless Customer against all third-party claims, liabilities, and damages.\n\n8. GOVERNING LAW\nThis agreement shall be governed by and construed under the laws of the State of Delaware.\n","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":68,"created_at":"2026-09-04T23:57:39.417Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-05T05:27:39.417Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"33319f36-52c8-40d4-b064-aa06652a4dd1","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"33319f36-52c8-40d4-b064-aa06652a4dd1.enc","original_name":"Employment_Contract.docx","mime_type":"application/vnd.openxmlformats-officedocument.wordprocessingml.document","size":36639,"sha256":"2d3263b8ba4f2951cdae2736ee5090f01b715cdeebe1eb267b561c1e318802c1","encrypted":true,"extracted_text":"Employment Agreement\n\nEmployee agrees to non-compete terms.","ocr_confidence":1,"version_group":"33319f36-52c8-40d4-b064-aa06652a4dd1","version_number":1,"risk_score":5,"created_at":"2026-09-01T08:03:28.624Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-01T13:38:56.197Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"c27c88e1-d798-429e-8028-de0f96bd8aa7","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"c27c88e1-d798-429e-8028-de0f96bd8aa7.enc","original_name":"Fictional_Employment_Agreement_Sample.pdf","mime_type":"application/pdf","size":3575,"sha256":"9ccc58a89a2cfe9979ad9c89b03ac4cea4558f4dbc43aa412d079f67104e0f3f","encrypted":true,"extracted_text":"\n\nEMPLOYMENT AGREEMENT\nAgreement No.: EA/2026/0174\nDocument Date: 04 August 2026\nThis Employment Agreement is entered into on the 4th day of August, 2026, at Hyderabad,\nTelangana.\nEMPLOYER\nNovaTech Solutions Private Limited, 8th Floor, Cyber Heights, HITEC City, Madhapur, Hyderabad,\nTelangana - 500081, represented by HR Director Ms. Ananya Mehta.\nEMPLOYEE\nMr. Rahul Sharma, S/o Mr. Rajesh Sharma, Age 25 Years, 12-45 Green Park Colony, Vijayawada,\nAndhra Pradesh - 520010.\n1. Appointment\nThe Employer appoints the Employee as Software Engineer.\n2. Joining Date\n18 August 2026.\n3. Place of Work\nHyderabad Development Centre. Transfer may be required.\n4. Probation\nSix (6) months.\n5. Compensation\nAnnual CTC: INR 8,40,000. Monthly Gross Salary: INR 70,000.\n6. Working Hours\nMonday to Friday, 9:30 AM to 6:30 PM.\n7. Leave Policy\n18 Earned Leaves, 12 Casual Leaves, 12 Sick Leaves annually.\n8. Duties\nPerform assigned duties, maintain confidentiality, follow company policies, protect company assets.\n9. Confidentiality\nThe Employee shall not disclose confidential information relating to clients, source code, trade\nsecrets, or financial information.\n10. Intellectual Property\nAll work created during employment remains the Employer's property.\n11. Termination\nEither party may terminate with 30 days written notice or salary in lieu thereof.\n12. Governing Law\nThis Agreement shall be governed by the laws of India.\nEmployer\nNovaTech Solutions Private Limited\nAuthorized Signatory: ____________________\nEmployee\n\nRahul Sharma\nSignature: ____________________\nWitness 1: ____________________\nWitness 2: ____________________\nThis document is entirely fictional and intended solely for software testing and demonstration purposes.","ocr_confidence":0.97,"version_group":"c27c88e1-d798-429e-8028-de0f96bd8aa7","version_number":1,"risk_score":0,"created_at":"2026-08-31T04:57:42.752Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-01T13:38:56.197Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"5eda363f-2e89-47dd-bfd3-86a64f297b4f","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"5eda363f-2e89-47dd-bfd3-86a64f297b4f.enc","original_name":"Sample_Residential_Purchase_Agreement.pdf","mime_type":"application/pdf","size":42812,"sha256":"ac7a59b29142df1a6791ddeab5b0cf56038a3599e81b2acce2d3508470723dba","encrypted":true,"extracted_text":"\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 1\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nIMPORTANT NOTICE: This is a fictional, sample legal document created for educational and\ncontract-review training purposes only. All parties, addresses, and figures are invented. It involves\nno real property or real transaction, is not legal advice, and must never be signed, relied upon, or\nused in any actual transaction. See the final page for a plain-language guide to this sample’s risky\nand missing clauses.\nRESIDENTIAL REAL ESTATE\nPURCHASE AND SALE AGREEMENT\n(SAMPLE / FICTIONAL DOCUMENT)\nEffective Date:August 15, 2026\nSeller:Patricia A. Kowalski\nBuyer:Daniel J. Whitfield\nProperty Address:4127 Maple Ridge Court, Rivergrove, State of Franklin 00000\nPurchase Price:$485,000.00\nEarnest Money Deposit:$9,700.00\nEscrow / Closing Agent:Meridian Title & Escrow, LLC\nTarget Closing Date:On or before September 30, 2026\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 2\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nRECITALS\nWHEREAS,  Seller  is  the  owner  of  certain  real  property  and  improvements  located  at  4127  Maple  Ridge\nCourt,  Rivergrove,  State  of  Franklin,  as  more  particularly  described  in  Exhibit  A  attached  hereto  (the\n“Property”); and\nWHEREAS, Buyer desires to purchase the Property from Seller, and Seller desires to sell the Property to\nBuyer, upon the terms and subject to the conditions set forth in this Agreement;\nNOW, THEREFORE, in consideration of the mutual covenants and agreements contained herein, and for\nother good and valuable consideration, the receipt and sufficiency of which are hereby acknowledged, the\nParties agree as follows:\nARTICLE 1 — DEFINITIONS\n1.1  “Agreement”    means  this  Residential  Real  Estate  Purchase  and  Sale  Agreement,  together  with  all\nExhibits attached hereto, as the same may be amended from time to time in accordance with Article 19.\n1.2  “Business  Day”    means  any  day  other  than  a  Saturday,  Sunday,  or  legal  holiday  recognized  in  the\nState of Franklin.\n1.3  “Closing”    means  the  consummation  of  the  purchase  and  sale  of  the  Property  in  accordance  with\nArticle 10.\n1.4 “Effective Date”  means the date this Agreement has been fully executed by both Parties, as set forth\nin the introductory paragraph.\n1.5  “Escrow  Agent”    means  Meridian  Title  &  Escrow,  LLC,  the  entity  designated  to  hold  the  Earnest\nMoney Deposit and to administer Closing.\n1.6  “Property”    means  the  real  property  and  improvements  described  in  Section  2.2  and  Exhibit  A,\ntogether with all fixtures and appurtenances described in Section 2.3.\n1.7 “Title Defect”  has the meaning given to it in Section 7.3.\n1.8  Interpretation.    Unless  the  context  otherwise  requires,  references  to  Articles  and  Sections  are\nreferences to Articles and Sections of this Agreement, and the word “including” means “including without\nlimitation.”\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 3\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nARTICLE 2 — PARTIES AND PROPERTY\n2.1  Parties.    This  Agreement  is  made  and  entered  into  as  of  August  15,  2026  (the  “Effective  Date”),  by\nand  between  Patricia  A.  Kowalski,  an  unmarried  individual  (“Seller”),  and  Daniel  J.  Whitfield,  an\nunmarried individual (“Buyer”). Seller and Buyer are sometimes referred to individually as a “Party” and\ncollectively as the “Parties.”\n2.2  Property.    Seller  agrees  to  sell  and  convey,  and  Buyer  agrees  to  purchase,  upon  the  terms  and\nconditions set forth in this Agreement, that certain real property commonly known as 4127 Maple Ridge\nCourt,  Rivergrove,  State  of  Franklin  00000,  together  with  all  improvements,  fixtures,  and  appurtenances\nthereto, and more particularly described in Exhibit A attached hereto and incorporated herein by reference.\n2.3 Included Items.  The sale of the Property includes all fixtures permanently attached thereto, including\nbuilt-in  appliances,  ceiling  fans,  and  window  treatments,  and  the  existing  heating,  ventilation,  and  air\nconditioning systems, in their present condition as of the Effective Date.\n2.4  Community  Association.    The  Property  is  located  within  the  Maple  Ridge  community  and  may  be\nsubject  to  a  mandatory  homeowners  association  and  its  governing  documents,  rules,  and  assessments.\nBuyer is advised to make independent inquiry regarding any such association.\nARTICLE 3 — PURCHASE PRICE AND PAYMENT\n3.1 Purchase Price.  The total purchase price for the Property is Four Hundred Eighty-Five Thousand\nand  00/100  Dollars  ($485,000.00)  (the  “Purchase  Price”),  payable  by  Buyer  to  Seller  at  Closing  in\naccordance with this Agreement.\n3.2 Method of Payment.  The Purchase Price, less the Earnest Money Deposit and adjusted for prorations\nunder Article 11, shall be paid by wire transfer of immediately available funds through Escrow Agent at\nClosing, in accordance with wiring instructions to be separately confirmed in writing.\n3.3 Personal Property.  No item of personal property is included in the sale except as expressly identified\nin Section 2.3 above.\nARTICLE 4 — EARNEST MONEY DEPOSIT\n4.1  Deposit.    Within  three  (3)  Business  Days  after  the  Effective  Date,  Buyer  shall  deposit  with  Escrow\nAgent the sum of Nine Thousand Seven Hundred Dollars ($9,700.00) (the “Earnest Money Deposit”) as\nevidence of Buyer’s good faith intent to perform this Agreement.\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 4\nNot for actual use — does not constitute legal advice — all parties and details are fictional\n4.2 Application.  The Earnest Money Deposit shall be credited toward the Purchase Price at Closing, or\notherwise disbursed in accordance with Article 15 of this Agreement.\n4.3 Failure to Deposit.  If Buyer fails to timely deliver the Earnest Money Deposit as required by Section\n4.1,  Seller  may  terminate  this  Agreement  immediately  upon  written  notice  to  Buyer,  and  Buyer  shall\nthereafter have no further rights under this Agreement.\nARTICLE 5 — FINANCING\n5.1 Buyer’s Financing.  Buyer intends to obtain a conventional mortgage loan to finance a portion of the\nPurchase Price and shall apply for such financing promptly following the Effective Date.\n5.2  No  Financing  Contingency.    Notwithstanding  Section  5.1,  Buyer’s  obligation  to  purchase  the\nProperty is not contingent upon Buyer obtaining financing on any terms. In the event Buyer is unable\nto obtain financing for any reason, or Buyer’s loan approval is delayed, reduced, denied, or withdrawn for\nany reason, Buyer shall remain fully and unconditionally obligated to close this transaction and to pay the\nfull  Purchase  Price,  and  Buyer’s  failure  to  do  so  shall  constitute  a  default  by  Buyer  under  Article  15,\nentitling Seller to retain the Earnest Money Deposit and to pursue all other remedies available under this\nAgreement.\n5.3 Appraisal.  No appraisal contingency is provided under this Agreement. If the Property appraises at a\nvalue  less  than  the  Purchase  Price  for  any  reason,  Buyer  shall  nonetheless  remain  obligated  to  close  this\ntransaction at the full Purchase Price stated in Section 3.1.\n5.4 Loan Application Cooperation.  Buyer shall cooperate in good faith with Buyer’s lender, including\nby  timely  submitting  all  documentation  requested  for  underwriting,  it  being  understood  that  any  delay\ncaused by Buyer’s lender shall not extend the Closing Date described in Article 10.\nARTICLE 6 — INSPECTIONS AND PROPERTY CONDITION\n6.1  Right  to  Inspect.    Buyer  shall  have  the  right,  at  Buyer’s  sole  cost  and  expense,  to  conduct  such\ninspections, tests, and investigations of the Property as Buyer deems appropriate, including general home\ninspection, pest inspection, and any specialized inspections Buyer elects to obtain.\n6.2 Inspection Period.  Buyer shall have a period of three (3) calendar days after the Effective Date (the\n“Inspection  Period”)  within  which  to  complete  all  inspections  of  the  Property.  Upon  expiration  of  the\nInspection  Period,  the  Property  shall  be  conclusively  deemed  accepted  by  Buyer  in  its  then-current\ncondition,  and  Buyer  irrevocably  waives  any  right  to  request  repairs,  credits,  or  a  reduction  in  the\nPurchase  Price,  or  to  terminate  this  Agreement,  on  account  of  any  condition  of  the  Property,\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 5\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nwhether or not such condition was known to, disclosed to, or discoverable by Buyer.\n6.3  “As  Is”  Condition.    EXCEPT  AS  EXPRESSLY  SET  FORTH  IN  THIS  AGREEMENT,  THE\nPROPERTY  IS  SOLD  “AS  IS,  WHERE  IS,  WITH  ALL  FAULTS,”  AND  SELLER  DISCLAIMS  ALL\nWARRANTIES,  WHETHER  EXPRESS  OR  IMPLIED,  INCLUDING  WITHOUT  LIMITATION  ANY\nIMPLIED   WARRANTY   OF   HABITABILITY,   MERCHANTABILITY,   OR   FITNESS   FOR   A\nPARTICULAR  PURPOSE.  BUYER  ACKNOWLEDGES  THAT  BUYER  IS  RELYING  SOLELY  ON\nBUYER’S  OWN  INSPECTION  OF  THE  PROPERTY  AND  NOT  ON  ANY  STATEMENT  OR\nREPRESENTATION  MADE  BY  SELLER  OR  SELLER’S  AGENTS,  AND  BUYER  WAIVES  ANY\nCLAIM   AGAINST   SELLER   ARISING   FROM   THE   CONDITION   OF   THE   PROPERTY,\nINCLUDING  ANY  CLAIM  BASED  ON  SELLER’S  FAILURE  TO  DISCLOSE  A  KNOWN\nDEFECT.\n6.4  Access  for  Inspections.    Seller  shall  provide  Buyer  and  Buyer’s  inspectors  reasonable  access  to  the\nProperty during the Inspection Period upon at least twenty-four (24) hours’ notice to Seller.\nARTICLE 7 — TITLE AND SURVEY\n7.1 Title Commitment.  Escrow Agent shall furnish to Buyer a title commitment for an owner’s policy of\ntitle insurance within fifteen (15) days after the Effective Date.\n7.2  Survey.    Buyer  may  obtain,  at  Buyer’s  own  expense,  a  current  survey  of  the  Property  prepared  by  a\nlicensed surveyor.\n7.3  Title  Defects.    If  the  title  commitment  or  survey  discloses  any  lien,  encumbrance,  easement,\nencroachment,  or  other  defect  affecting  title  to  the  Property  (a  “Title  Defect”),  Seller  shall  have  no\nobligation to cure any such Title Defect. Buyer’s sole and exclusive remedy for any Title Defect shall be\nto terminate this Agreement by written notice delivered to Seller within five (5) days after Buyer’s receipt\nof the title commitment or survey disclosing the same, in which event the Earnest Money Deposit shall be\nreleased  to  Seller  as  liquidated  damages.  If  Buyer  fails  to  timely  deliver  such  notice,  Buyer  shall  be\ndeemed to have accepted title subject to all such Title Defects, without reduction in the Purchase Price.\n7.4  Title  Insurance.    Buyer  may,  at  Buyer’s  own  expense,  obtain  an  owner’s  policy  of  title  insurance\ninsuring Buyer’s title to the Property, subject to the standard printed exceptions of the issuing title insurer.\nARTICLE 8 — SELLER DISCLOSURES\n8.1  Disclosure  Statement.    Seller  has  furnished  Buyer  with  a  Seller’s  Property  Disclosure  Statement,\nattached as Exhibit B. Seller makes no representations or warranties, express or implied, regarding\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 6\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nthe  condition  of  the  Property,  including  without  limitation  the  roof,  foundation,  electrical  system,\nplumbing  system,  heating  and  cooling  systems,  or  septic  or  sewer  system,  except  as  may  be  expressly\nrequired  by  applicable  law.  Seller’s  Disclosure  Statement  is  based  solely  on  Seller’s  actual,  subjective\nknowledge  as  of  the  date  given,  and  Seller  shall  have  no  duty  to  inspect,  investigate,  or  otherwise\ninquire into the condition of the Property in order to complete such statement.\n8.2  Buyer’s  Independent  Investigation.    Buyer  acknowledges  that  Buyer  has  been  advised  to  obtain\nindependent professional inspections of the Property and has either done so within the Inspection Period\ndescribed in Article 6, or has knowingly and voluntarily elected to forgo such inspections.\nARTICLE 9 — ENVIRONMENTAL AND STATUTORY NOTICES\n9.1  Flood  Zone.    To  Seller’s  actual  knowledge  only,  and  without  any  independent  verification,  the\nProperty  is  not  located  within  a  designated  special  flood  hazard  area.  Buyer  is  solely  responsible  for\nindependently confirming flood zone status with the appropriate governmental authority prior to expiration\nof the Inspection Period.\n9.2  Radon  Gas  Notice.    Radon  is  a  naturally  occurring  radioactive  gas  that,  when  accumulated  in  a\nbuilding  in  sufficient  quantities,  may  present  health  risks  to  persons  exposed  to  it  over  time.  Levels  of\nradon  exceeding  applicable  guidelines  have  been  found  in  buildings  in  the  State  of  Franklin.  Additional\ninformation regarding radon may be obtained from the applicable county health department. Seller has not\nconducted, and has no obligation under this Agreement to conduct, any radon testing of the Property.\n9.3  Soil  and  Subsurface  Conditions.    Seller  has  not  conducted,  and  has  no  obligation  under  this\nAgreement  to  conduct,  any  soil  or  subsurface  environmental  testing  of  the  Property.  Buyer  may  elect  to\nconduct such testing, at Buyer’s own expense, within the Inspection Period described in Article 6.\n9.4  Zoning  and  Permits.    Seller  represents,  to  Seller’s  actual  knowledge  only,  that  no  notice  of  any\npending zoning violation or unpermitted alteration has been received by Seller with respect to the Property.\n9.5  Mold  Notice.    Mold  is  present  to  some  degree  in  virtually  all  buildings  and  may,  under  certain\nconditions  of  moisture  intrusion,  become  a  health  concern.  Buyer  is  encouraged  to  have  the  Property\ninspected for the presence of mold during the Inspection Period. Seller makes no representation regarding\nthe presence or absence of mold at the Property.\n9.6 Registered Offender Information.  Information regarding registered offenders residing in the vicinity\nof the Property may be obtained from the applicable state or county public registry. Neither Seller nor any\nreal  estate  broker  involved  in  this  transaction  has  an  obligation  to  research  or  disclose  such  information,\nand Buyer is encouraged to make independent inquiry.\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 7\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nARTICLE 10 — CLOSING\n10.1  Closing  Date.    The  closing  of  this  transaction  (“Closing”)  shall  occur  on  or  before  September  30,\n2026, or such other date as the Parties may agree to in writing (the “Closing Date”). Time is of the essence\nwith respect to the Closing Date.\n10.2  Closing  Location.    Closing  shall  take  place  at  the  offices  of  Escrow  Agent,  or  by  mail-away  or\nremote escrow closing if agreed to in writing by the Parties.\n10.3 Possession.  Seller shall deliver possession of the Property to Buyer at Closing, broom-clean and free\nof Seller’s personal property and debris, except for any items expressly included in the sale under Section\n2.3.\n10.4 Closing Documents.  At Closing, Seller shall execute and deliver a general warranty deed conveying\nthe Property to Buyer, subject to matters of record and any Title Defects deemed accepted by Buyer under\nSection  7.3,  together  with  a  customary  owner’s  affidavit  and  such  other  documents  as  Escrow  Agent\nreasonably requires to close the transaction.\nARTICLE 11 — PRORATIONS AND CLOSING COSTS\n11.1 Prorations.  Real property taxes and assessments, if any, shall be prorated between Seller and Buyer\nas of the Closing Date based on the most recently available tax bill for the Property.\n11.2  Closing  Costs.    Buyer  shall  be  solely  responsible  for  all  closing  costs  associated  with  this\ntransaction,  including  without  limitation  the  premiums  for  both  the  owner’s  and  any  lender’s  title\ninsurance policies, recording fees, escrow and closing fees charged by Escrow Agent, applicable transfer\ntaxes, and Seller’s attorney’s fees incurred in connection with this transaction, regardless of local custom\nor practice. Seller shall bear no closing costs of any kind under this Agreement.\nARTICLE 12 — BROKERAGE AND AGENCY\n12.1  Broker  Representation.    Buyer  and  Seller  each  acknowledge  that  they  have  been  advised  of  their\nright to be represented by a licensed real estate broker or agent of their own choosing in connection with\nthis transaction.\n12.2 Commission.  Any commission owed to a real estate broker in connection with this transaction shall\nbe  paid  by  Seller  at  Closing  pursuant  to  a  separate  written  listing  or  commission  agreement,  and  this\nAgreement creates no obligation running to any broker not a party hereto.\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 8\nNot for actual use — does not constitute legal advice — all parties and details are fictional\n12.3 No Warranty by Brokers.  Buyer acknowledges that any real estate broker or agent involved in this\ntransaction is not a party to this Agreement, has made no independent verification of the condition of the\nProperty, and has no liability for any representation made by Seller.\nARTICLE 13 — INSURANCE AND HOME WARRANTY\n13.1  Hazard  Insurance.    Buyer  shall  obtain,  at  Buyer’s  sole  cost  and  expense,  a  policy  of  hazard  and\nhomeowner’s insurance covering the Property, effective as of the Closing Date, and shall furnish evidence\nof such coverage to Escrow Agent prior to Closing.\n13.2 No Home Warranty.  No home warranty plan or service contract is provided by Seller in connection\nwith this transaction. Buyer may, at Buyer’s own option and expense, obtain a home warranty plan from a\nprovider of Buyer’s choosing.\n13.3 Evidence of Insurability.  Buyer shall, within the Inspection Period described in Article 6, obtain a\nclaims-history or equivalent report with respect to the Property and satisfy itself as to the insurability of the\nProperty. Failure to do so shall not extend the Inspection Period or excuse Buyer’s performance under this\nAgreement.\nARTICLE 14 — REPRESENTATIONS AND WARRANTIES\n14.1 Buyer’s Representations.  Buyer represents and warrants to Seller that: (a) Buyer has the full right,\npower, and authority to enter into and perform Buyer’s obligations under this Agreement; (b) Buyer has, or\nwill have prior to Closing, sufficient funds or financing arranged to close this transaction on the terms set\nforth  herein;  and  (c)  Buyer  has  independently  investigated  the  Property  to  Buyer’s  own  satisfaction,\nsubject to Article 6.\n14.2  Seller’s  Representations.    Seller  represents,  to  Seller’s  actual  knowledge  and  without  any  duty  of\nfurther  inquiry  or  investigation,  that  Seller  holds  fee  simple  title  to  the  Property.  Seller  makes  no  other\nrepresentation  or  warranty  of  any  kind,  express  or  implied,  in  connection  with  this  Agreement  or  the\nProperty.\nARTICLE 15 — DEFAULT AND REMEDIES\n15.1 Default by Buyer.  If Buyer fails to perform any obligation under this Agreement, time being of the\nessence, Seller may, at Seller’s sole option and without limitation: (a) terminate this Agreement and retain\nthe Earnest Money Deposit as liquidated damages, the Parties agreeing that Seller’s actual damages in such\nevent  would  be  difficult  to  ascertain  with  precision;  and  (b)  notwithstanding  retention  of  the  Earnest\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 9\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nMoney  Deposit,  pursue  any  and  all  other  remedies  available  at  law  or  in  equity,  including  without\nlimitation an action for specific performance and recovery of consequential and incidental damages,\nit  being  agreed  that  retention  of  the  Earnest  Money  Deposit  shall  not  constitute  Seller’s  sole  or\nexclusive remedy.\n15.2 Default by Seller.  If Seller fails to perform any obligation under this Agreement, Buyer’s sole and\nexclusive remedy shall be return of the Earnest Money Deposit, and Buyer expressly waives, releases,\nand  relinquishes  any  right  to  seek  specific  performance,  consequential  damages,  incidental  damages,  or\nany other remedy at law or in equity on account of any default by Seller.\n15.3 Attorneys’ Fees.  In any action or proceeding arising under this Agreement, each Party shall bear its\nown attorneys’ fees and costs, except as otherwise expressly provided in Article 16.\nARTICLE 16 — INDEMNIFICATION\n16.1 Buyer’s Indemnification of Seller.  Buyer shall indemnify, defend, and hold harmless Seller and\nSeller’s  agents,  employees,  and  real  estate  brokers  from  and  against  any  and  all  claims,  demands,\nlosses,  damages,  liabilities,  and  expenses  (including  reasonable  attorneys’  fees)  arising  out  of  or  in\nany way related to Buyer’s inspection of, entry upon, or purchase of the Property, without regard to\nthe  cause  of  such  claim,  including  claims  arising  in  whole  or  in  part  from  the  negligence  of  Seller,\nand without any cap or limitation on the amount of such liability.\n16.2  No  Reciprocal  Obligation.    Seller  shall  have  no  obligation  to  indemnify,  defend,  or  hold  harmless\nBuyer under this Agreement.\nARTICLE 17 — DISPUTE RESOLUTION\n17.1 Binding Arbitration.  Any dispute, claim, or controversy arising out of or relating to this Agreement\nshall be resolved exclusively by binding arbitration administered in Ashworth County, State of Franklin\n— Seller’s home county — regardless of the location of the Property or Buyer’s place of residence. Buyer\nshall  bear  all  filing  fees,  administrative  costs,  and  arbitrator’s  fees  associated  with  any  such\narbitration, regardless of the outcome of the proceeding.\n17.2 Waiver of Jury Trial and Class Action.  EACH PARTY KNOWINGLY, VOLUNTARILY, AND\nINTENTIONALLY   WAIVES   ANY   RIGHT   TO   A   TRIAL   BY   JURY   AND   ANY   RIGHT   TO\nPARTICIPATE   IN   A   CLASS   OR   CONSOLIDATED   ACTION,   IN   ANY   LITIGATION   OR\nARBITRATION ARISING OUT OF OR RELATED TO THIS AGREEMENT. THE ARBITRATOR’S\nDECISION SHALL BE FINAL AND BINDING AND MAY NOT BE APPEALED.\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 10\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nARTICLE 18 — NOTICES\n18.1  Form  of  Notice.    All  notices,  requests,  consents,  and  other  communications  required  or  permitted\nunder this Agreement shall be in writing.\n18.2  Delivery.    Notices  shall  be  deemed  effectively  given  when  delivered  personally,  when  sent  by\novernight courier with confirmation of delivery, or three (3) days after being deposited in the mail, postage\nprepaid, certified or registered, return receipt requested, addressed to the applicable Party at the address set\nforth on the signature page of this Agreement.\n18.3  Electronic  Notice.    Notice  by  electronic  mail  shall  be  effective  only  if  expressly  acknowledged  in\nwriting by the receiving Party.\n18.4 Change of Address.  Either Party may change its address for notice by providing written notice of\nsuch change to the other Party in accordance with this Article 18.\nARTICLE 19 — GENERAL PROVISIONS\n19.1  Entire  Agreement.    This  Agreement,  including  all  Exhibits  attached  hereto,  constitutes  the  entire\nagreement  between  the  Parties  with  respect  to  its  subject  matter  and  supersedes  all  prior  negotiations,\nrepresentations, or agreements, whether written or oral.\n19.2 Amendment.  This Agreement may be amended only by a written instrument signed by both Parties.\n19.3 Severability.  If any provision of this Agreement is held to be invalid or unenforceable, the remaining\nprovisions shall nonetheless continue in full force and effect.\n19.4 Assignment.  Seller may assign this Agreement, in whole or in part, to any third party without\nBuyer’s  consent.  Buyer  may  not  assign  this  Agreement  or  any  rights  arising  hereunder  without  Seller’s\nprior written consent, which consent may be withheld in Seller’s sole and absolute discretion.\n19.5 Governing Law.  This Agreement shall be governed by and construed in accordance with the laws of\nthe State of Franklin, without regard to its conflict-of-laws principles.\n19.6 Force Majeure.  Neither Party shall be liable for any delay in performance, other than the payment of\nmoney,  caused  by  circumstances  beyond  that  Party’s  reasonable  control,  provided  that  this  Section  shall\nnot extend the Closing Date by more than five (5) Business Days.\n19.7 Waiver.  No waiver of any provision of this Agreement shall be effective unless in writing and signed\nby  the  Party  against  whom  the  waiver  is  sought  to  be  enforced,  and  no  such  waiver  shall  be  deemed  a\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 11\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nwaiver of any other or subsequent breach.\n19.8  Counterparts.    This  Agreement  may  be  executed  in  one  or  more  counterparts,  including  by\nelectronic signature, each of which shall be deemed an original and all of which together shall constitute\none and the same instrument.\n19.9 Headings.  The Article and Section headings used in this Agreement are for convenience of reference\nonly and shall not affect the interpretation or construction of this Agreement.\n19.10  Further  Assurances.    Each  Party  agrees  to  execute  and  deliver  such  further  documents  and\ninstruments, and to take such further actions, as may be reasonably necessary or appropriate to carry out\nand effectuate the purposes and intent of this Agreement.\n19.11  Relationship  of  Parties.    Nothing  contained  in  this  Agreement  shall  be  construed  to  create  a\npartnership, joint venture, fiduciary relationship, or agency relationship between Buyer and Seller.\n19.12 No Third-Party Beneficiaries.  Except as expressly set forth in Article 12 with respect to real estate\nbrokers, this Agreement is intended solely for the benefit of Buyer and Seller, and no other person or entity\nshall have any right to enforce any provision of this Agreement.\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 12\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nSIGNATURES\nIN WITNESS WHEREOF, the Parties have executed this Agreement as of the dates set forth below, to be\neffective as of the Effective Date first written above.\nSELLER:\n_____________________________________Date: _______________\nPatricia A. Kowalski\nAddress for Notices:\n118 Birchwood Lane, Ashworth, State of Franklin 00001\nBUYER:\n_____________________________________Date: _______________\nDaniel J. Whitfield\nAddress for Notices:\n92 Larkspur Avenue, Unit 4B, Rivergrove, State of Franklin 00000\nEscrow  Agent  Acknowledgment:  Meridian  Title  &  Escrow,  LLC  acknowledges  receipt  of  a  fully\nexecuted counterpart of this Agreement and agrees to act as Escrow Agent in accordance with its terms.\n_____________________________________Date: _______________\nAuthorized Signatory, Meridian Title & Escrow, LLC\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 13\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nEXHIBIT A\nLEGAL DESCRIPTION OF PROPERTY\nLot 14, Block 7, of MAPLE RIDGE SUBDIVISION, PHASE II, according to the plat thereof recorded in\nPlat Book 41, Page 116, of the public records of Ashworth County, State of Franklin.\nTogether  with  all  improvements  located  thereon,  commonly  known  as  4127  Maple  Ridge  Court,\nRivergrove, State of Franklin 00000.\nTax Parcel No.: 07-14-226-014-0000\nYear Built: 1965\nLot Size: 0.28 acres (approx.)\nZoning: Single-Family Residential (R-1)\n[Note:  In  an  actual  transaction,  this  Exhibit  would  reproduce  the  full  metes-and-bounds  or  platted  legal\ndescription exactly as it appears on the current deed and title commitment.]\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 14\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nEXHIBIT B\nSELLER’S PROPERTY DISCLOSURE STATEMENT (SUMMARY)\nSeller has completed the disclosure summary below to the best of Seller’s actual knowledge, without any\nobligation to inspect or investigate the Property. See Section 8.1 of the Agreement.\nItemResponseComments\nRoof age / known leaksUnknownNot specified by Seller\nFoundation cracks or settlingNo\nBasement / crawlspace water intrusionUnknown\nTermite or wood-destroying insect damageNo\nPresence of moldUnknown\nLead-based paint (property built 1965)Not Answered\nAsbestos insulation or flooring materialsUnknown\nUnderground fuel storage tank, past or presentNo\nAdditions or alterations made without permitUnknown\nHistory of flooding or drainage problemsNoPer Seller's recollection only\nKnown defects in electrical systemUnknown\nKnown defects in plumbing systemNo\n[Note: In an actual transaction, this Exhibit would be the complete, state-mandated disclosure form, fully\nanswered and separately signed and dated by Seller.]\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 15\nNot for actual use — does not constitute legal advice — all parties and details are fictional\nAPPENDIX — NOTES FOR REVIEWERS\nThis  page  is  not  part  of  the  sample  agreement  itself  —  it’s  a  plain-language  key  for  whoever  is  using  this\ndocument to practice spotting problems in a real estate contract. Everything above is fictional and fabricated for\nthis purpose.\nClauses worth flagging as risky or one-sided\n•§  5.2  —  No  Financing  Contingency.  Buyer  must  close  in  cash  and  forfeits  the  deposit  if  financing  falls\nthrough, for any reason, including lender denial through no fault of Buyer’s own. Most balanced agreements\ncondition the deal on Buyer actually securing a loan within a stated window.\n•§  6.2  –  6.3  —  Three-Day  Inspection  Waiver.  A  three-day  inspection  period  is  unusually  short  (ten-plus\ndays is typical), and the accompanying waiver purports to bar any claim “whether or not disclosed,” including\nfor defects Seller actually knew about and hid.\n•§ 7.3 — No Duty to Cure Title Defects. If Seller’s title turns out to be encumbered or clouded, Buyer’s only\noption  is  to  walk  away  —  and  still  lose  the  deposit.  A  typical  contract  obligates  Seller  to  clear  defects,  or\ngives Buyer a refund rather than a forfeiture, when Seller’s own title is the problem.\n•§  8.1  —  Weak  Disclosure  Obligation.  Seller’s  disclosure  duty  is  limited  to  subjective,  uninvestigated\n“actual knowledge,” with an express statement that Seller need not inspect the Property before answering.\nCombined with the Section 6.3 waiver and the “Unknown” answers in Exhibit B, this makes it very hard for\nBuyer to later prove Seller concealed a known defect.\n•§  9.1  —  Buyer  Bears  Flood-Zone  Verification.  Seller’s  flood-zone  statement  is  knowledge-only  and\nunverified,  and  the  burden  of  confirming  actual  flood  risk  is  shifted  entirely  to  Buyer  within  a  very  short\ninspection window.\n•§ 11.2 — One-Sided Closing Costs. Buyer pays every closing cost, including costs (like the owner’s title\npolicy) that local custom in most markets assigns to Seller.\n•§ 15.1 – 15.2 — Asymmetric Default Remedies. If Buyer defaults, Seller keeps the deposit and can still\nsue  for  more  —  a  “double  recovery”  that  most  courts  frown  on  and  that  a  liquidated-damages  clause  is\nsupposed  to  prevent.  If  Seller  defaults,  Buyer’s  only  remedy  is  getting  the  deposit  back,  with  an  explicit\nwaiver  of  specific  performance  —  unusual  since  real  estate  is  normally  treated  as  unique,  precisely  so  a\nbuyer can sue to force the sale through.\n•§ 16.1 — Uncapped One-Way Indemnity. Buyer must cover Seller’s legal costs and liabilities with no dollar\ncap, even for claims caused by Seller’s own negligence, and Seller owes Buyer nothing reciprocal.\n•§ 17.1 – 17.2 — Arbitration Stacked Against Buyer. Mandatory arbitration is set in Seller’s home county\nrather than a neutral or property-local venue, Buyer pays the arbitration costs win or lose, and Buyer gives\nup jury trial, class action, and appeal rights.\n•§ 19.4 — One-Way Assignment Rights. Seller can hand the contract off to anyone; Buyer needs Seller’s\ndiscretionary sign-off to do the same.\nStandard protections that this sample leaves out\n\nSAMPLE — FOR TRAINING USE ONLY\nSAMPLE DOCUMENT — FICTIONAL — FOR EDUCATIONAL / TRAINING USE ONLY — NOT A REAL CONTRACT\nSample Residential Purchase and Sale Agreement (Fictional)Page 16\nNot for actual use — does not constitute legal advice — all parties and details are fictional\n•No  attorney-review  /  cancellation  window.  Many  jurisdictions  rely  on  a  short  post-signing  period  during\nwhich either party’s attorney can cancel or request changes. This form has no such clause.\n•No risk-of-loss / casualty clause. There is no provision addressing what happens if the home is damaged\n— by fire, storm, or otherwise — between signing and Closing. Silence here tends to favor whichever party\nhas more leverage to dictate what happens next.\n•No pre-closing walk-through right. Buyers are typically given an explicit right to walk through the Property\nshortly before Closing to confirm its condition hasn’t changed. It’s absent here.\n•No  completed  lead-based  paint  disclosure.  Exhibit  A  shows  the  home  was  built  in  1965,  and  Exhibit  B\nleaves the lead-paint question “Not Answered.” Federal law requires a specific lead-based-paint disclosure\nand acknowledgment for pre-1978 housing; this form doesn't include one.\n•No itemized inclusions/exclusions list. Section 2.3 describes included fixtures only in general terms, with\nno  room-by-room  or  item-by-item  list  (e.g.,  appliances,  mounted  TVs,  shelving)  —  a  common  source  of\npost-closing disputes.\n•No HOA estoppel / dues-proration clause. Section 2.4 flags a homeowners association, but nothing later\nrequires  an  HOA  estoppel  letter,  discloses  current  dues  or  special  assessments,  or  prorates  them  at\nClosing.\n•No survival clause. Nothing states which provisions (e.g., representations, indemnification) survive Closing\nversus merge into the deed, leaving that question to default doctrine and litigation.\n•No  lien-release  /  mortgage-payoff  obligation.  There’s  no  express  requirement  that  Seller  pay  off  and\nrelease any existing mortgage or lien at or before Closing.\nNone of this is legal advice, and this list isn’t exhaustive. A real purchase agreement should be reviewed by a\nlicensed real estate attorney in the relevant jurisdiction before anyone signs it. If you’re using this file to test a\ncontract-review tool and want a “blind” version without the answer key, just delete this last page.","ocr_confidence":0.97,"version_group":"5eda363f-2e89-47dd-bfd3-86a64f297b4f","version_number":1,"risk_score":5,"created_at":"2026-08-31T05:30:57.588Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-01T13:38:56.197Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"c1473c7a-1cb3-47e1-80bd-566c6ebfd5a6","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"c1473c7a-1cb3-47e1-80bd-566c6ebfd5a6.enc","original_name":"sample_nda.txt","mime_type":"text/plain","size":772,"sha256":"a1441a7ad2ea7b5dfa532699661efca23bc31ad616b6c7d72dbb59d575a19873","encrypted":true,"extracted_text":"NON-DISCLOSURE AGREEMENT\nThis Non-Disclosure Agreement (\"Agreement\") is entered into as of January 1, 2026, by and between Cyberdyne Systems and Sarah Connor.\n1. Confidential Information: Both parties agree to maintain strict confidentiality regarding proprietary technology.\n2. Term & Termination: This Agreement shall terminate on December 31, 2028. Either party may terminate with 30 days written notice.\n3. Governing Law: This Agreement shall be governed by the laws of India and the Indian Contract Act, 1872.\n4. Liability: In no event shall either party be liable for indirect or consequential damages.\n5. Payment & Renewal: Annual maintenance fee of $5,000 is due on March 15, 2026.\nContact email: sarah.connor@cyberdyne.org, PAN: ABCDE1234F, Phone: +91 9876543210.","ocr_confidence":1,"version_group":"c1473c7a-1cb3-47e1-80bd-566c6ebfd5a6","version_number":1,"risk_score":5,"created_at":"2026-08-31T08:02:30.084Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-01T13:38:56.197Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"dc215310-6577-48e9-aced-9ab2607b9975","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"dc215310-6577-48e9-aced-9ab2607b9975.enc","original_name":"sample_nda.txt","mime_type":"text/plain","size":772,"sha256":"a1441a7ad2ea7b5dfa532699661efca23bc31ad616b6c7d72dbb59d575a19873","encrypted":true,"extracted_text":"NON-DISCLOSURE AGREEMENT\nThis Non-Disclosure Agreement (\"Agreement\") is entered into as of January 1, 2026, by and between Cyberdyne Systems and Sarah Connor.\n1. Confidential Information: Both parties agree to maintain strict confidentiality regarding proprietary technology.\n2. Term & Termination: This Agreement shall terminate on December 31, 2028. Either party may terminate with 30 days written notice.\n3. Governing Law: This Agreement shall be governed by the laws of India and the Indian Contract Act, 1872.\n4. Liability: In no event shall either party be liable for indirect or consequential damages.\n5. Payment & Renewal: Annual maintenance fee of $5,000 is due on March 15, 2026.\nContact email: sarah.connor@cyberdyne.org, PAN: ABCDE1234F, Phone: +91 9876543210.","ocr_confidence":1,"version_group":"dc215310-6577-48e9-aced-9ab2607b9975","version_number":1,"risk_score":5,"created_at":"2026-08-31T08:05:14.801Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-01T13:38:56.197Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"c78b1c22-64f3-4fa2-a549-ea70ab06cd53","user_i