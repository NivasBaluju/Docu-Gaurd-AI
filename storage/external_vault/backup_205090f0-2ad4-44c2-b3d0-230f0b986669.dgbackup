 invoices shall be payable Net 30.\nGoverning Law: This agreement shall be governed by the laws of the State of Delaware.\nDefault: Party shall cure breach within 30 days of written notice.\n","ocr_confidence":null,"version_group":"6a28db64-08cb-4ff7-8636-e79404168d09","version_number":1,"risk_score":40,"created_at":"2026-09-04T13:26:40.998Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-04T18:56:40.998Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"24cd0fa5-af70-4ec1-a386-f12d06357665","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"MSA_Acme_v2.pdf","original_name":"MSA_Acme_v2.pdf","mime_type":null,"size":null,"sha256":null,"encrypted":true,"extracted_text":"\nMASTER SERVICES AGREEMENT (V2)\nEffective Date: October 01, 2025\nThis Agreement expires on October 01, 2026.\nTerm and Renewal: This Agreement shall automatically renew for successive terms of 1 year unless either party gives written notice of at least 30 days prior to expiration.\nLimitation of Liability: The aggregate liability under this agreement shall be limited to $2,000,000 USD.\nPayment Terms: All invoices shall be payable Net 60.\nGoverning Law: This agreement shall be governed by the laws of the State of New York.\nDefault: Party shall cure breach within 30 days of written notice.\n","ocr_confidence":null,"version_group":"6a28db64-08cb-4ff7-8636-e79404168d09","version_number":2,"risk_score":65,"created_at":"2026-09-04T13:26:41.495Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-04T18:56:41.495Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"8ab0c1e1-e955-4c18-a03a-b03ae1c26fbb","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"Secret_TenantB_Agreement.pdf","original_name