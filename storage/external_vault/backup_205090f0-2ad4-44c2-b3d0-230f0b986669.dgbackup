 of Liability\nTotal aggregate liability shall not exceed fees paid under this agreement.\n\nSection 6. Indemnification\nSupplier shall indemnify, defend, and hold harmless Customer against all claims and damages without limitation.\n\nSection 7. Emergency Cure Notice\nAny default must be cured within fifteen (15) days' prior written notice.\n\nSection 8. Billing Terms\nInvoices shall be due within fifteen (15) days of issuance.","ocr_confidence":null,"version_group":"45451e83-bd92-496c-b675-f2056d4f0574","version_number":1,"risk_score":28,"created_at":"2026-09-02T07:24:01.194Z","storage_path":"C:\\Users\\DELL\\Downloads\\Docu-Gaurd AI\\Docu-Gaurd AI\\data\\uploads\\45451e83-bd92-496c-b675-f2056d4f0574.enc","extraction_status":"COMPLETED","extraction_method":"DIRECT_TEXT","page_count":1,"character_count":889,"processed_at":"2026-09-02T12:54:05.707Z","analysis_status":"COMPLETED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"dbc01cb0-7890-42a6-8032-42fe3c59cc93","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"dbc01cb0-7890-42a6-8032-42fe3c59cc93.pdf","original_name":"Vendor Non-Disclosure Agreement.pdf","mime_type":"application/pdf","size":4096,"sha256":null,"encrypted":true,"extracted_text":"Test contract text for Phase 7.9 compliance and evidence export.","ocr_confidence":null,"version_group":null,"version_number":1,"risk_score":null,"created_at":"2026-09-02T10:42:01.982Z","storage_path":null,"extraction_status":"COMPLETED","extraction_method":null,"page_count":1,"character_count":0,"processed_at":"2026-09-02T16:12:01.982Z","analysis_status":"NOT_STARTED","analysis_error":null,"analysis_error_internal":null,"tenant_id":null},{"id":"62174c2a-46bc-4c39-b464-36267d83375b","user_id":"f9074205-a2e9-453a-859e-0375159b08fc","filename":"62174c2a-46bc-4c39-b464-36267d83375b.pdf","original_name":"Confidential Partner SOW.pdf","mime_type":"application/pdf","size":4096,"sha256":null,"encrypted":true,"extracted_text":"Test contract t